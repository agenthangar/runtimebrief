    "fastify": "^5.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "runtimebriefd": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "scripts"
