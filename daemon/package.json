{
  "name": "runtimebriefd",
  "version": "0.1.0",
  "description": "RuntimeBrief daemon — evidence-backed project state for AI agent fleets",
  "homepage": "https://github.com/agenthangar/runtimebrief#readme",
  "bugs": {
    "url": "https://github.com/agenthangar/runtimebrief/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthangar/runtimebrief.git",
    "directory": "daemon"
  },
  "main": "dist/cli.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
